# =============================================================================
# Lavish Travels & Tours — environment variables
#
# Copy to .env.local for development. NEVER commit a real .env* file — only
# this template. Variables prefixed NEXT_PUBLIC_ are sent to the browser;
# everything else is server-only and must stay that way (webhook secrets,
# API keys, service-role keys).
# =============================================================================

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.lavishtravelstours.co.za
NODE_ENV=development

# --- Supabase --------------------------------------------------------------
# Project MUST be provisioned in the af-south-1 (Cape Town) region for
# latency and POPIA s.72 data-residency (see Section 9 / README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client, never prefix
# with NEXT_PUBLIC_. Used only in trusted server contexts (webhooks, admin).
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ----------------------------------------------------------
# Paystack — primary card gateway.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Ozow — Instant EFT.
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_IS_TEST=true

# Payfast — swappable alternative provider (configured, not wired live in Phase 1).
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Manual EFT / bank transfer reconciliation (always-available fallback).
MANUAL_EFT_BANK_NAME=
MANUAL_EFT_ACCOUNT_NAME=
MANUAL_EFT_ACCOUNT_NUMBER=
MANUAL_EFT_BRANCH_CODE=

# Active provider for the PaymentProvider interface: paystack | ozow | payfast | manual_eft
PAYMENTS_DEFAULT_PROVIDER=paystack

# --- Email (Resend + React Email) -----------------------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS="Lavish Travels & Tours <bookings@lavishtravelstours.co.za>"
ENQUIRIES_NOTIFY_EMAIL=

# --- WhatsApp Business API (via BSP) ---------------------------------------
# Phase 1 ships plain wa.me click-to-chat only — no secrets required yet.
NEXT_PUBLIC_WHATSAPP_NUMBER=27000000000
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_PHONE_NUMBER_ID=

# --- Google Maps Platform ----------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Analytics -----------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Vercel Speed Insights is auto-wired via @vercel/speed-insights; no key needed.

# --- FX rates (multi-currency display toggle, Phase 2) ----------------------
FX_RATE_API_KEY=
FX_RATE_BASE_CURRENCY=ZAR

# --- Rate limiting / abuse prevention (enquiry form, newsletter) -----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Revalidation (on-demand ISR webhook, Section 3) ------------------------
REVALIDATE_SECRET=

# --- Supabase (booking platform) -------------------------------------------
# Supabase has no African region. Use eu-central-1 (Frankfurt) for the best
# latency from South Africa, and document the POPIA s.72 cross-border basis
# (Supabase DPA + privacy policy). See supabase/SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses ALL row-level security. Never prefix NEXT_PUBLIC_,
# never send to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, for running migrations from the CLI.
DATABASE_URL=
